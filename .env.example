# ==============================================================================
# ENVIRONMENT VARIABLES - SMART GRAIN STORAGE MONITORING SYSTEM
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grain_storage_db?schema=public"

# Authentication & Security
JWT_SECRET="grain_storage_jwt_super_secret_key_2026_change_in_production"
JWT_EXPIRES_IN="1d"

# MQTT Broker (Eclipse Mosquitto)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_WS_URL="ws://localhost:9001"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# Telegram Alert Bot (Optional for High-Risk Alerts)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

